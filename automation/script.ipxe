#!ipxe

set base-url http://repos-prod-az/release

:main
menu --name main Choose an Operating System or Utility
item --menu main rocky Rocky Linux
item --menu main rhel Red Hat Enterprise Linux
item --menu main windows Mircosoft Windows
item --menu main utils Utilities
item --menu main reboot Reboot
item --menu main poweroff Poweroff
item --menu main exit Exit
choose --menu main --default exit --timeout 60000 target && goto ${taget}


# RHEL submenu options
:rhel
menu --name rhel Choose RHEL Major Version
item --menu rhel rhel7 Red Hat Enterprise Linux 7
item --menu rhel rhel8 Red Hat Enterprise Linux 8
item --menu rhel rhel9 Red Hat Enterprise Linux 9
item --menu rhel rhel10 Red Hat Enterprise Linux 10
item --menu rhel back Go back to main menu
choose --menu rhel target && goto ${target}

:rhel7
set resource-path ${base-url}/rhel/7
menu --name rhel7 Choose a RHEL 7 Boot Option
item --menu rhel7 workstation-el7 RHEL 7 Workstation
item --menu rhel7 server-el7 RHEL 7 Server Product
item --menu rhel7 servergui-el7 RHEL 7 Server with GUI
item --menu rhel7 minimal-el7 RHEL 7 Minimal
item --menu rhel7 custom-el7 RHEL 7 Custom
item --menu rhel7 back Go back to main menu
choose --menu rhel7 target && goto ${target}

:workstation-el7
kernel ${resource-path}/vmlinuz inst.repo=${resource-path}/BaseOS/x86_64 inst.ks=${resource-path}/kickstarts/rhel7_workstation.ks
initrd ${resource-path}/initrd.img
boot

:server-el7
kernel ${resource-path}/vmlinuz inst.repo=${resource-path}/BaseOS/x86_64 inst.ks=${resource-path}/kickstarts/rhel7_server.ks
initrd ${resource-path}/initrd.img
boot

:servergui-el7
kernel ${resource-path}/vmlinuz inst.repo=${resource-path}/BaseOS/x86_64 inst.ks=${resource-path}/kickstarts/rhel7_server_gui.ks
initrd ${resource-path}/initrd.img
boot

:minimal-el7
kernel ${resource-path}/vmlinuz inst.repo=${resource-path}/BaseOS/x86_64 inst.ks=${resource-path}/kickstarts/rhel7_minimal.ks
initrd ${resource-path}/initrd.img
boot

:custom-el7
form --name el7-form Define Custom RHEL7 Boot Parameters
item repo-url Repo URL
item ks-url Kickstart URL
item vmlinuz-url Compressed Kernel Exe (vmlinuz) URL
item initrd-url Initial Ramdisk Image (initrd) URL
present

kernel ${vmlinuz-url} inst.repo=${repo-url} inst.ks=${ks-url}
initrd ${initrd-url}
boot


:rhel8
menu --name rhel8 Choose a RHEL 8 Boot Option
item --menu rhel8 workstation-el8 RHEL 8 Workstation
item --menu rhel8 server-el8 RHEL 8 Server Product
item --menu rhel8 servergui-el8 RHEL 8 Server with GUI
item --menu rhel8 minimal-el8 RHEL 8 Minimal
item --menu rhel8 custom-el8 RHEL 8 Custom
item --menu rhel8 back Go back to main menu
choose --menu rhel8 target && goto ${target}

:workstation-el8

:server-el8

:servergui-el8

:minimal-el8

:custom-el8

